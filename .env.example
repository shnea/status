# 상태창 ENV 명세. 안전한 예시이며 실설정 파일로 사용하지 않는다.
# 실제 원본: .env.local.sops.env / .env.dev.sops.env / .env.prod.sops.env
# 모든 실행 명령은 --env-file로 대상을 명시한다.

# 필수: local | dev | prod
APP_ENV=local
# 필수: local/dev는 development, prod는 runtime. 두 실행 프로필을 함께 켜지 않는다.
COMPOSE_PROFILES=development
# 선택: 같은 Docker 호스트에 여러 환경을 둘 때 서로 다른 프로젝트명 사용.
COMPOSE_PROJECT_NAME=status
# 필수: 호스트 포트·바인딩. 외부 Nginx 접근 시 허용 네트워크에 맞게 바인딩 변경.
APP_PORT=30165
APP_BIND_ADDRESS=127.0.0.1
# 필수: 브라우저 원점. HTTPS 도메인을 사용하면 쿠키도 true로 변경.
APP_PUBLIC_URL=http://localhost:30165
SESSION_COOKIE_SECURE=false

# 개발에서 필수: 소스의 기존 절대 경로. runtime 실행에서는 불필요.
PROJECT_SOURCE_DIR=
# 필수: 영구 DB 데이터의 기존 절대 경로.
DB_DATA_DIR=
# 운영 및 백업 명령에서 필수: DB 경로와 분리된 기존 절대 백업 디렉터리.
BACKUP_DIR=
# 필수: DB 관리 접속은 루프백에만 노출.
DB_PORT=30166
POSTGRES_DB=status
POSTGRES_USER=status
# 필수/비밀
POSTGRES_PASSWORD=

# 필수: Docker 런타임 이미지. 버전 변경 시 호환성을 검증한다.
POSTGRES_IMAGE=postgres:17
JAVA_IMAGE=eclipse-temurin:17-jdk-jammy
NODE_IMAGE=node:24-bookworm-slim
NGINX_IMAGE=nginx:stable-alpine

# 선택: 빌드할 운영 서버 CPU. Apple Silicon Mac에서도 AMD NAS용 이미지를 생성한다.
APP_IMAGE_PLATFORM=linux/amd64

# 운영에서 필수: 검증한 패키지 이미지의 명시적 태그 또는 digest.
# 아래 로컬 태그는 개발 PC의 패키지 검사 예시. 운영 서버에서 실제 이용 가능한 이미지를 지정.
BACKEND_APP_IMAGE=status-backend:local
FRONTEND_APP_IMAGE=status-frontend:local
PDF_APP_IMAGE=status-pdf:local
# 복구 검사에서만 지정: db-backup이 출력한 파일명(디렉터리 경로 제외).
BACKUP_FILE=

# 필수: 실제 플랫폼 URL·UUID·키는 암호화 원본에 입력. 아래 URL은 설명용.
PLATFORM_BASE_URL=https://platform.example.com
PLATFORM_PROJECT_ID=
PLATFORM_ENVIRONMENT_ID=
# 서버 전용 비밀값
PLATFORM_API_KEY=
PLATFORM_OIDC_ISSUER=https://platform.example.com/auth/realms/example
PLATFORM_OIDC_CLIENT_ID=app
# 플랫폼에 등록한 콜백·로그아웃 복귀 주소. APP_PUBLIC_URL과 원점 일치.
PLATFORM_OIDC_REDIRECT_URI=http://localhost:30165/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:30165/

# 최초 가입 전 두 값 모두 빈 값 허용. 한쪽만 입력하면 실행 실패.
# 가입 후 검증된 issuer와 subject가 동시에 일치하는 단일 관리자.
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_SUBJECT=

# 파일 연동 시 필수: 해당 플랫폼 환경에 등록된 장기 보관 코드.
PLATFORM_FILE_RETENTION_CODE=

# 선택: 운영 Search Console의 별도 HTML 태그 인증이 필요한 경우.
# 공개 확인용 값이며 API 키가 아니다. local/dev에서는 비워둔다.
GOOGLE_SITE_VERIFICATION=
